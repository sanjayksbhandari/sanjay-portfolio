{
  "name": "sanjay-portfolio",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:links": "tsx scripts/check-internal-links.ts",
    "validate": "npm run lint && npm run typecheck && npm run format:check && npm run validate:content && npm run validate:links",
    "validate:production": "npm run validate && npm run build",
    "launch:check": "npm run validate:production",
    "release:check": "npm run launch:check",
    "sync:changelog": "tsx scripts/sync-changelog.ts",
    "prepare": "husky",
    "generate:resume": "tsx scripts/generate-resume-pdf.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.4.5",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toast": "^1.2.21",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@radix-ui/react-visually-hidden": "^1.2.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "pdfkit": "^0.19.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
